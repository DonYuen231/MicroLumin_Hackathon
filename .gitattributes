* text=auto

# These run inside Linux containers or shells, so they must keep LF
*.sh text eol=lf
gradlew text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf

# Windows scripts
*.bat text eol=crlf

# Binary files
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.mp3 binary
*.wav binary
*.jar binary
