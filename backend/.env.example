# Copy to .env and fill in. Never commit .env.

# Shared secret the phone app sends as a bearer token
APP_TOKEN=

# NanoGPT: set this key to "subscription only" in NanoGPT settings
NANOGPT_API_KEY=
# Confirm the base URL and model name in the NanoGPT docs
NANOGPT_BASE_URL=
LLM_MODEL=

# Speech-to-text provider: nanogpt or deepgram
STT_PROVIDER=nanogpt
DEEPGRAM_API_KEY=

FACE_MODEL=buffalo_l
