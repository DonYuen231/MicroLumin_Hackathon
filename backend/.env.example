# Copy to .env and fill in. Never commit .env.

# Shared secret the phone app sends as a bearer token. REQUIRED: the server refuses to start without it.
APP_TOKEN=change-me

# NanoGPT: set this key to "subscription only" in NanoGPT settings
NANOGPT_API_KEY=your-nanogpt-key
NANOGPT_BASE_URL=https://nano-gpt.com/api/subscription/v1

# Profile LLM (reasoning_effort=low, temperature 0.1, JSON mode)
LLM_MODEL=z-ai/glm-5.3

# Speech-to-text provider: nanogpt or deepgram
STT_PROVIDER=nanogpt
STT_MODEL=xiaomi/mimo-v2.6-pro
DEEPGRAM_API_KEY=

FACE_MODEL=buffalo_l
